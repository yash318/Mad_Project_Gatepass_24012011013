<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, Student 👋"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#101828"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your hostel gate passes easily"
            android:textSize="15sp"
            android:textColor="#667085"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="22dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gate Pass"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply for permission to leave the hostel"
                    android:textSize="14sp"
                    android:textColor="#667085"
                    android:layout_marginTop="5dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyGatePass"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Apply Gate Pass"
                    android:layout_marginTop="14dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyPasses"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="My Gate Passes"
            android:layout_marginTop="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Gate Pass History"
            android:layout_marginTop="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="My Profile"
            android:layout_marginTop="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Logout"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>